/// Tabla contenedora de medidas. Sin datos. Carpetas: Volumen, Price Intelligence, Confiabilidad.
table _Medidas
	lineageTag: 5bdd61f1-b1ba-4ca0-bec3-8a66345d2c0f

	/// Suma del volumen 1P predicho. Por defecto usa el motor Isotonica y el ambiente Producción si no hay uno seleccionado (evita doble conteo entre motores y entre tracks). Responde al slicer de Brent y al de Ambiente.
	measure 'Vol 1P Predicho' =
			VAR _motor = IF ( HASONEVALUE ( 'Motor'[Motor] ), VALUES ( 'Motor'[Motor] ), "Isotonica" )
			VAR _amb = IF ( HASONEVALUE ( 'Ambiente'[Ambiente] ), VALUES ( 'Ambiente'[Ambiente] ), "Producción" )
			RETURN
			CALCULATE ( SUM ( 'Predicción'[Volumen 1P Predicho (MBPE)] ), KEEPFILTERS ( 'Motor'[Motor] = _motor ), KEEPFILTERS ( 'Ambiente'[Ambiente] = _amb ) )
		formatString: 0.0000
		displayFolder: 1. Volumen
		lineageTag: e7cec50d-8099-40d8-b177-83a1b40dfc11

	/// 1P certificado base. Independiente de Brent y Motor (constante por campo).
	measure 'Vol 1P Baseline' = SUMX ( VALUES ( 'Campo'[Campo] ), CALCULATE ( MAX ( 'Modelo Campo'[Volumen 1P Baseline (MBPE)] ) ) )
		formatString: #,##0.00
		displayFolder: 1. Volumen
		lineageTag: c639524e-85a4-40b7-985e-05819ed4bdb0

		annotation PBI_FormatHint = {"isCustom":true}

	/// Volumen predicho menos baseline.
	measure 'Delta vs Base (MBPE)' = [Vol 1P Predicho] - [Vol 1P Baseline]
		formatString: #,##0.0
		displayFolder: 1. Volumen
		lineageTag: 664e0531-dec8-43cf-ac31-90ab6798d334

	measure 'Delta vs Base %' = DIVIDE ( [Delta vs Base (MBPE)], [Vol 1P Baseline] )
		formatString: 0.0%
		displayFolder: 1. Volumen
		lineageTag: dbd6b3c8-84d9-4139-a20a-c4ff9d428632

	measure '# Campos' = DISTINCTCOUNT ( 'Predicción'[Campo Clave] )
		formatString: #,##0
		displayFolder: 1. Volumen
		lineageTag: f4907f34-b7f3-4095-abeb-5f89755bad48

	/// Campos con Precio Neto >= Precio de Equilibrio al Brent seleccionado.
	measure '# Campos Viables' = CALCULATE ( DISTINCTCOUNT ( 'Predicción'[Campo Clave] ), KEEPFILTERS ( 'Predicción'[Es Viable] = TRUE () ) )
		formatString: #,##0
		displayFolder: 1. Volumen
		lineageTag: 9838377e-0f0b-4f4c-8c62-e172a4b95fd3

	measure '# Campos Full Reservas' = CALCULATE ( DISTINCTCOUNT ( 'Predicción'[Campo Clave] ), KEEPFILTERS ( 'Predicción'[Es Full Reservas] = TRUE () ) )
		formatString: #,##0
		displayFolder: 1. Volumen
		lineageTag: 7cfc01e8-8669-46e3-bd82-df32ca3a089d

	/// % de la materialidad (1P certificado) que sigue siendo viable al Brent del escenario:
	/// suma del baseline de los campos con Precio Neto ≥ Precio de Equilibrio / baseline total.
	/// Reemplaza a '% Volumen Viable' (que daba 100% siempre: el volumen predicho ya es 0 bajo
	/// el breakeven por el piso duro, así que no-viables no restaban del cociente).
	measure '% Materialidad Viable' = DIVIDE ( CALCULATE ( [Vol 1P Baseline], KEEPFILTERS ( 'Predicción'[Es Viable] = TRUE () ) ), [Vol 1P Baseline] )
		formatString: 0.0%
		displayFolder: 1. Volumen
		lineageTag: 6f95e5b1-ad90-4a19-b607-dfd91285b334

	/// Precio Brent seleccionado en el slicer.
	measure 'Brent Escenario (USD/bbl)' = SELECTEDVALUE ( 'Precio Brent'[Brent (USD/bbl)] )
		formatString: $#,##0.00
		displayFolder: 2. Price Intelligence
		lineageTag: 4a5317ba-2d89-47af-971f-e5fcbe9801c8

	/// Volumen predicho si el Brent sube 5 USD (análogo period-over-period sobre el eje precio).
	measure 'Vol @ Brent +5' =
			VAR b = SELECTEDVALUE ( 'Precio Brent'[Brent (USD/bbl)] )
			RETURN IF ( NOT ISBLANK ( b ), CALCULATE ( [Vol 1P Predicho], REMOVEFILTERS ( 'Precio Brent' ), 'Precio Brent'[Brent (USD/bbl)] = b + 5 ) )
		formatString: #,##0.0
		displayFolder: 2. Price Intelligence
		lineageTag: 92859479-6ea6-467c-af11-b643f9f2aa2a

	/// Volumen predicho si el Brent baja 5 USD.
	measure 'Vol @ Brent -5' =
			VAR b = SELECTEDVALUE ( 'Precio Brent'[Brent (USD/bbl)] )
			RETURN IF ( NOT ISBLANK ( b ), CALCULATE ( [Vol 1P Predicho], REMOVEFILTERS ( 'Precio Brent' ), 'Precio Brent'[Brent (USD/bbl)] = b - 5 ) )
		formatString: #,##0.0
		displayFolder: 2. Price Intelligence
		lineageTag: 87bd1e0d-bcf7-451f-b2db-3300e739a6ee

	/// Sensibilidad: cambio de volumen por un escalón de +5 USD de Brent.
	measure 'Δ Vol por +5 USD (MBPE)' =
			VAR b = SELECTEDVALUE ( 'Precio Brent'[Brent (USD/bbl)] )
			RETURN IF ( NOT ISBLANK ( b ), [Vol @ Brent +5] - [Vol 1P Predicho] )
		formatString: #,##0.0
		displayFolder: 2. Price Intelligence
		lineageTag: 37488612-ba6c-4190-ac1a-b69cebf5b88d

	/// Pendiente local del volumen respecto al Brent (diferencia central ±5 USD / 10).
	measure 'Elasticidad Local (MBPE/USD)' =
			VAR b = SELECTEDVALUE ( 'Precio Brent'[Brent (USD/bbl)] )
			RETURN IF ( NOT ISBLANK ( b ), DIVIDE ( [Vol @ Brent +5] - [Vol @ Brent -5], 10 ) )
		formatString: #,##0.00
		displayFolder: 2. Price Intelligence
		lineageTag: 87dab452-65cc-49cb-a22d-20cfc84ef929

	/// Volumen al Brent de referencia (ancla ~68). Debe aproximar el baseline (sanity C5).
	measure 'Vol @ Brent Ref' =
			VAR bref = MAX ( 'Corrida'[Brent Ref (USD/bbl)] )
			RETURN CALCULATE ( [Vol 1P Predicho], REMOVEFILTERS ( 'Precio Brent' ), 'Precio Brent'[Brent (USD/bbl)] = ROUND ( bref, 0 ) )
		formatString: #,##0.0
		displayFolder: 2. Price Intelligence
		lineageTag: 558945e2-6356-4ed0-97f7-7992b2cb2d34

	/// Precio Neto M2 menos Precio de Equilibrio. Usar con un campo y Brent seleccionados.
	measure 'Colchón vs Precio de Equilibrio (USD)' = CALCULATE ( AVERAGE ( 'Predicción'[Precio Neto M2 (USD/bbl)] ) ) - CALCULATE ( AVERAGE ( 'Modelo Campo'[Precio de Equilibrio (USD/bbl)] ) )
		formatString: $#,##0.00
		displayFolder: 2. Price Intelligence
		lineageTag: c2456978-bd46-49ba-9f6f-bfb6324799f3

	/// Precio Neto M2 menos Breakeven. Usar con un campo y Brent seleccionados.
	measure 'Colchón vs Breakeven (USD)' = CALCULATE ( AVERAGE ( 'Predicción'[Precio Neto M2 (USD/bbl)] ) ) - CALCULATE ( AVERAGE ( 'Modelo Campo'[Breakeven (USD/bbl)] ) )
		formatString: $#,##0.00
		displayFolder: 2. Price Intelligence
		lineageTag: de91332c-4172-4932-b644-b8a47f9cc0d7

	/// Proporción de campos que usan beta de portafolio (sin historia propia).
	measure '% Campos Fallback M2' = DIVIDE ( CALCULATE ( DISTINCTCOUNT ( 'Modelo Campo'[Campo Clave] ), KEEPFILTERS ( 'Modelo Campo'[M2 Es Fallback] = TRUE () ) ), [# Campos] )
		formatString: 0.0%
		displayFolder: 3. Confiabilidad
		lineageTag: 711806d3-7c69-419d-9862-b7b63b2c9a6a

	measure '# Campos Confianza ALTA' = CALCULATE ( DISTINCTCOUNT ( 'Modelo Campo'[Campo Clave] ), KEEPFILTERS ( 'Modelo Campo'[Nivel Confianza] = "ALTA" ) )
		formatString: #,##0
		displayFolder: 3. Confiabilidad
		lineageTag: 95eb4fcd-16a7-401a-88e8-8aa27bf04d96

	measure '# Campos Confianza MEDIA' = CALCULATE ( DISTINCTCOUNT ( 'Modelo Campo'[Campo Clave] ), KEEPFILTERS ( 'Modelo Campo'[Nivel Confianza] = "MEDIA" ) )
		formatString: #,##0
		displayFolder: 3. Confiabilidad
		lineageTag: eb3f7ae9-6d84-493a-b150-cf734fec9935

	measure '# Campos Confianza BAJA' = CALCULATE ( DISTINCTCOUNT ( 'Modelo Campo'[Campo Clave] ), KEEPFILTERS ( 'Modelo Campo'[Nivel Confianza] = "BAJA" ) )
		formatString: #,##0
		displayFolder: 3. Confiabilidad
		lineageTag: db5cd1a8-cb8b-4783-b0fd-2defd7e1fd10

	/// Campos sin deck real (gas/insensible al precio): predicción = último cierre plano.
	measure '# Campos Insensibles al Precio' = CALCULATE ( DISTINCTCOUNT ( 'Modelo Campo'[Campo Clave] ), KEEPFILTERS ( 'Modelo Campo'[Nivel Confianza] = "INSENSIBLE_PRECIO" ) )
		formatString: #,##0
		displayFolder: 3. Confiabilidad
		lineageTag: b09a3a62-b16b-426a-8f72-fb0efd64cbc7

	/// Fracción del volumen predicho en zona de Brent extrapolada.
	measure '% Vol Extrapolado' = DIVIDE ( CALCULATE ( [Vol 1P Predicho], KEEPFILTERS ( 'Predicción'[Es Extrapolado] = TRUE () ) ), [Vol 1P Predicho] )
		formatString: 0.0%
		displayFolder: 3. Confiabilidad
		lineageTag: 315c62d9-a22d-4149-bcba-81566d937b5a

	/// Título dinámico del escenario Brent (páginas 1–3).
	measure 'Título Escenario' = "Reservas 1P del portafolio — Brent " & FORMAT ( [Brent Escenario (USD/bbl)], "$#,##0" ) & "/bbl"
		displayFolder: 0. Títulos
		lineageTag: 1f4e2c90-7a3b-4d51-9c68-2e5b8a4f0c11

	/// Título dinámico con el campo seleccionado (Explorador / Diagnóstico).
	measure 'Título Campo' = "Respuesta al precio — " & SELECTEDVALUE ( Campo[Campo], "Portafolio completo" )
		displayFolder: 0. Títulos
		lineageTag: 2a5f3d81-8b4c-4e62-ad79-3f6c9b5a1d22

	/// Quarter objetivo + fecha de generación de la predicción vigente (para la cabecera).
	measure 'Fecha Última Predicción' = "Predicción " & MAX ( 'Corrida'[Q Objetivo] ) & " · generada " & FORMAT ( MAX ( 'Corrida'[Fecha Predicción] ), "yyyy-mm-dd" )
		displayFolder: 0. Títulos
		lineageTag: 3b6f4e92-9c5d-4a73-be18-4d7fac6b2e33

	/// Precio de Equilibrio (VPN=0, precio de abandono; por debajo no hay reservas) del campo seleccionado. Para línea de referencia.
	measure 'Línea Precio de Equilibrio (USD/bbl)' = AVERAGE ( 'Modelo Campo'[Precio de Equilibrio (USD/bbl)] )
		formatString: $#,##0.00
		displayFolder: 2. Price Intelligence
		lineageTag: 5e8b2a41-3c9d-4e17-b6a2-7f1c8d4e9a51

	/// Breakeven (Límite Económico, FC último año con aceite=0; mantener reservas) del campo seleccionado. Para línea de referencia.
	measure 'Línea Breakeven (USD/bbl)' = AVERAGE ( 'Modelo Campo'[Breakeven (USD/bbl)] )
		formatString: $#,##0.00
		displayFolder: 2. Price Intelligence
		lineageTag: 5e8b2a41-3c9d-4e17-b6a2-7f1c8d4e9a52

	/// Campos con recta M2 frágil (fallback, <5 puntos o R² LOO<0). Traducción Brent→precio poco confiable.
	measure 'Alerta M2 Frágil' = CALCULATE ( DISTINCTCOUNT ( 'Modelo Campo'[Campo Clave] ), KEEPFILTERS ( 'Modelo Campo'[M2 Frágil] = TRUE () ) )
		formatString: #,##0
		displayFolder: 3. Confiabilidad
		lineageTag: 4c7a5f13-2e8b-49d6-a1f4-5b9e3c7d8a41

	/// Campos con outlier en validación LOO de M1 (RMSE/MAE > 2): un punto real domina el error.
	measure 'Alerta Outlier LOO' = CALCULATE ( DISTINCTCOUNT ( 'Modelo Campo'[Campo Clave] ), KEEPFILTERS ( 'Modelo Campo'[Alerta LOO Outlier] = TRUE () ) )
		formatString: #,##0
		displayFolder: 3. Confiabilidad
		lineageTag: 4c7a5f13-2e8b-49d6-a1f4-5b9e3c7d8a42

	/// Campos con sensibilidad no identificada (confound de vigencia): la pendiente de precio no es separable del cambio de deck anual.
	measure 'Alerta Confound' = CALCULATE ( DISTINCTCOUNT ( 'Modelo Campo'[Campo Clave] ), KEEPFILTERS ( 'Modelo Campo'[Sensibilidad No Identificada] = TRUE () ) )
		formatString: #,##0
		displayFolder: 3. Confiabilidad
		lineageTag: 4c7a5f13-2e8b-49d6-a1f4-5b9e3c7d8a43

	/// Total de banderas de alerta activas (un campo puede disparar varias).
	measure '# Alertas Total' = [Alerta M2 Frágil] + [Alerta Outlier LOO] + [Alerta Confound]
		formatString: #,##0
		displayFolder: 3. Confiabilidad
		lineageTag: 4c7a5f13-2e8b-49d6-a1f4-5b9e3c7d8a44

	/// Volumen del campo SOLO si dispara M2 Frágil (blanco si no) — para barra apilada por tipo de alerta.
	measure 'Vol si M2 Frágil (MBPE)' = IF ( CALCULATE ( COUNTROWS ( FILTER ( 'Modelo Campo', 'Modelo Campo'[M2 Frágil] = TRUE () ) ) ) > 0, [Vol 1P Predicho] )
		formatString: #,##0.0
		displayFolder: 3. Confiabilidad
		lineageTag: 6d8b3f24-9a5c-4e82-bf39-6c8d2e5f9b61

	/// Volumen del campo SOLO si dispara Outlier LOO.
	measure 'Vol si Outlier LOO (MBPE)' = IF ( CALCULATE ( COUNTROWS ( FILTER ( 'Modelo Campo', 'Modelo Campo'[Alerta LOO Outlier] = TRUE () ) ) ) > 0, [Vol 1P Predicho] )
		formatString: #,##0.0
		displayFolder: 3. Confiabilidad
		lineageTag: 6d8b3f24-9a5c-4e82-bf39-6c8d2e5f9b62

	/// Volumen del campo SOLO si dispara Confound de vigencia.
	measure 'Vol si Confound (MBPE)' = IF ( CALCULATE ( COUNTROWS ( FILTER ( 'Modelo Campo', 'Modelo Campo'[Sensibilidad No Identificada] = TRUE () ) ) ) > 0, [Vol 1P Predicho] )
		formatString: #,##0.0
		displayFolder: 3. Confiabilidad
		lineageTag: 6d8b3f24-9a5c-4e82-bf39-6c8d2e5f9b63

	/// Suma de las 6 medidas de alerta (orden de la barra apilada; no se muestra en el visual). Ampliado 2026-07-16 con Sesgo Recuperación, Clipped, Extrapolado.
	measure 'Total Vol Alertas (MBPE)' = COALESCE ( [Vol si M2 Frágil (MBPE)], 0 ) + COALESCE ( [Vol si Outlier LOO (MBPE)], 0 ) + COALESCE ( [Vol si Confound (MBPE)], 0 ) + COALESCE ( [Vol si Sesgo Recuperación (MBPE)], 0 ) + COALESCE ( [Vol si Clipped (MBPE)], 0 ) + COALESCE ( [Vol si Extrapolado (MBPE)], 0 )
		formatString: #,##0.0
		displayFolder: 3. Confiabilidad
		lineageTag: 6d8b3f24-9a5c-4e82-bf39-6c8d2e5f9b64

	/// Curva 1P completa sobre el eje DESCONECTADO 'Eje Brent'. Ignora el slicer ('Precio Brent')
	/// para que la línea muestre todo el rango de Brent mientras el escenario se marca aparte.
	measure 'Vol 1P Curva' =
			CALCULATE (
				[Vol 1P Predicho],
				REMOVEFILTERS ( 'Precio Brent' ),
				TREATAS ( VALUES ( 'Eje Brent'[Brent (USD/bbl)] ), 'Precio Brent'[Brent (USD/bbl)] )
			)
		formatString: #,##0.0
		displayFolder: 2. Price Intelligence
		lineageTag: 8a1b2c3d-4e5f-6a7b-8c9d-0e1f2a3b4c60

	/// Marca el volumen SOLO en el punto del eje igual al Brent del slicer (blanco en el resto).
	measure 'Marcador Escenario' =
			VAR _sel = [Brent Escenario (USD/bbl)]
			VAR _eje = SELECTEDVALUE ( 'Eje Brent'[Brent (USD/bbl)] )
			RETURN
				IF ( NOT ISBLANK ( _eje ) && ROUND ( _eje, 2 ) = ROUND ( _sel, 2 ), [Vol 1P Curva] )
		formatString: #,##0.0
		displayFolder: 2. Price Intelligence
		lineageTag: 8a1b2c3d-4e5f-6a7b-8c9d-0e1f2a3b4c61

	/// SENSIBILIDAD relativa: el Δ de volumen por +5 USD como % del 1P propio del campo.
	measure 'Sensibilidad Relativa (% por +5 USD)' = DIVIDE ( [Δ Vol por +5 USD (MBPE)], [Vol 1P Baseline] )
		formatString: 0.0%
		displayFolder: 2. Price Intelligence
		lineageTag: 8a1b2c3d-4e5f-6a7b-8c9d-0e1f2a3b4c62

	/// Campos con cierre pero sin modelo (ni deck ni breakeven): predicción = último cierre plano.
	measure '# Campos Sin Modelo' = CALCULATE ( DISTINCTCOUNT ( 'Modelo Campo'[Campo Clave] ), KEEPFILTERS ( 'Modelo Campo'[Nivel Confianza] = "SIN_MODELO" ) )
		formatString: #,##0
		displayFolder: 3. Confiabilidad
		lineageTag: b09a3a62-b16b-426a-8f72-fb0efd64cbc8

	/// Volumen 1P del track Producción al Brent del escenario. Ignora el slicer de Ambiente (fija Producción).
	measure 'Vol 1P Prod' = CALCULATE ( [Vol 1P Predicho], REMOVEFILTERS ( 'Ambiente' ), 'Ambiente'[Ambiente] = "Producción" )
		formatString: #,##0.0
		displayFolder: 4. Comparativa Ambientes
		lineageTag: c0a10001-2b3c-4d5e-8f90-a1b2c3d40001

	/// Volumen 1P del track Calidad al Brent del escenario. Ignora el slicer de Ambiente (fija Calidad).
	measure 'Vol 1P Cal' = CALCULATE ( [Vol 1P Predicho], REMOVEFILTERS ( 'Ambiente' ), 'Ambiente'[Ambiente] = "Calidad" )
		formatString: #,##0.0
		displayFolder: 4. Comparativa Ambientes
		lineageTag: c0a10001-2b3c-4d5e-8f90-a1b2c3d40002

	/// Diferencia de volumen 1P Calidad − Producción (MBPE) al Brent del escenario.
	measure 'Dif Vol Cal-Prod (MBPE)' = [Vol 1P Cal] - [Vol 1P Prod]
		formatString: +#,##0.0;-#,##0.0;0.0
		displayFolder: 4. Comparativa Ambientes
		lineageTag: c0a10001-2b3c-4d5e-8f90-a1b2c3d40003

	/// Diferencia de volumen 1P Calidad − Producción como % del volumen Producción.
	measure 'Dif Vol Cal-Prod %' = DIVIDE ( [Dif Vol Cal-Prod (MBPE)], [Vol 1P Prod] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4. Comparativa Ambientes
		lineageTag: c0a10001-2b3c-4d5e-8f90-a1b2c3d40004

	/// Curva 1P del portafolio (track Producción) sobre el eje desconectado 'Eje Brent'.
	measure 'Vol Curva Prod' = CALCULATE ( [Vol 1P Curva], REMOVEFILTERS ( 'Ambiente' ), 'Ambiente'[Ambiente] = "Producción" )
		formatString: #,##0.0
		displayFolder: 4. Comparativa Ambientes
		lineageTag: c0a10001-2b3c-4d5e-8f90-a1b2c3d40005

	/// Curva 1P del portafolio (track Calidad) sobre el eje desconectado 'Eje Brent'.
	measure 'Vol Curva Cal' = CALCULATE ( [Vol 1P Curva], REMOVEFILTERS ( 'Ambiente' ), 'Ambiente'[Ambiente] = "Calidad" )
		formatString: #,##0.0
		displayFolder: 4. Comparativa Ambientes
		lineageTag: c0a10001-2b3c-4d5e-8f90-a1b2c3d40006

	/// Banda baja LOYO (P10) del track Calidad al Brent del escenario. Reusa 'Vol 1P P10'
	/// (fix 2026-07-15: antes sumaba en crudo solo los campos con banda propia y quedaba
	/// por debajo de la curva central; ver 'Vol 1P P10').
	measure 'Vol P10 Cal' = CALCULATE ( [Vol 1P P10], REMOVEFILTERS ( 'Ambiente' ), 'Ambiente'[Ambiente] = "Calidad" )
		formatString: #,##0.0
		displayFolder: 4. Comparativa Ambientes
		lineageTag: c0a10001-2b3c-4d5e-8f90-a1b2c3d40007

	/// Banda alta LOYO (P90) del track Calidad al Brent del escenario. Reusa 'Vol 1P P90'.
	measure 'Vol P90 Cal' = CALCULATE ( [Vol 1P P90], REMOVEFILTERS ( 'Ambiente' ), 'Ambiente'[Ambiente] = "Calidad" )
		formatString: #,##0.0
		displayFolder: 4. Comparativa Ambientes
		lineageTag: c0a10001-2b3c-4d5e-8f90-a1b2c3d40008

	/// Banda baja P10 (Calidad) sobre 'Eje Brent' para dibujarla como línea punteada en la curva comparativa.
	measure 'Vol P10 Curva Cal' = CALCULATE ( [Vol P10 Cal], REMOVEFILTERS ( 'Precio Brent' ), TREATAS ( VALUES ( 'Eje Brent'[Brent (USD/bbl)] ), 'Precio Brent'[Brent (USD/bbl)] ) )
		formatString: #,##0.0
		displayFolder: 4. Comparativa Ambientes
		lineageTag: c0a10001-2b3c-4d5e-8f90-a1b2c3d40009

	/// Banda alta P90 (Calidad) sobre 'Eje Brent' para dibujarla como línea punteada en la curva comparativa.
	measure 'Vol P90 Curva Cal' = CALCULATE ( [Vol P90 Cal], REMOVEFILTERS ( 'Precio Brent' ), TREATAS ( VALUES ( 'Eje Brent'[Brent (USD/bbl)] ), 'Precio Brent'[Brent (USD/bbl)] ) )
		formatString: #,##0.0
		displayFolder: 4. Comparativa Ambientes
		lineageTag: c0a10001-2b3c-4d5e-8f90-a1b2c3d4000a

	/// Campos cuyo punto Producción cae FUERA de la banda P10-P90 de Calidad al Brent del escenario (inconsistencia material entre tracks).
	measure '# Campos Prod Fuera de Banda' =
			SUMX (
				VALUES ( 'Campo'[Campo] ),
				VAR p = [Vol 1P Prod]
				VAR p10 = [Vol P10 Cal]
				VAR p90 = [Vol P90 Cal]
				RETURN IF ( NOT ISBLANK ( p10 ) && ( p < p10 || p > p90 ), 1 )
			)
		formatString: #,##0
		displayFolder: 4. Comparativa Ambientes
		lineageTag: c0a10001-2b3c-4d5e-8f90-a1b2c3d4000b

	/// Total de campos con emparejamiento Producción↔Calidad (tabla puente Comparativa Tracks).
	measure '# Campos Comparados' = COUNTROWS ( 'Comparativa Tracks' )
		formatString: #,##0
		displayFolder: 4. Comparativa Ambientes
		lineageTag: c0a10001-2b3c-4d5e-8f90-a1b2c3d4000c

	/// Campos que cambian de nivel de confianza entre Producción y Calidad.
	measure '# Campos Migran Nivel' = COUNTROWS ( FILTER ( 'Comparativa Tracks', 'Comparativa Tracks'[Nivel Prod] <> 'Comparativa Tracks'[Nivel Cal] ) )
		formatString: #,##0
		displayFolder: 4. Comparativa Ambientes
		lineageTag: c0a10001-2b3c-4d5e-8f90-a1b2c3d4000d

	/// Campos donde el MAE LOYO de Calidad es MENOR (mejor ajuste) que el de Producción.
	measure '# Campos Mejoran MAE' = COUNTROWS ( FILTER ( 'Comparativa Tracks', 'Comparativa Tracks'[MAE LOYO Cal] < 'Comparativa Tracks'[MAE LOYO Prod] ) )
		formatString: #,##0
		displayFolder: 4. Comparativa Ambientes
		lineageTag: c0a10001-2b3c-4d5e-8f90-a1b2c3d4000e

	/// MAE LOYO ponderado por baseline 1P — track Producción (misma métrica-gate del pipeline).
	measure 'MAE LOYO Pond Prod' = DIVIDE ( SUMX ( 'Comparativa Tracks', 'Comparativa Tracks'[Baseline (MBPE)] * 'Comparativa Tracks'[MAE LOYO Prod] ), SUMX ( 'Comparativa Tracks', 'Comparativa Tracks'[Baseline (MBPE)] ) )
		formatString: #,##0.00
		displayFolder: 4. Comparativa Ambientes
		lineageTag: c0a10001-2b3c-4d5e-8f90-a1b2c3d4000f

	/// MAE LOYO ponderado por baseline 1P — track Calidad.
	measure 'MAE LOYO Pond Cal' = DIVIDE ( SUMX ( 'Comparativa Tracks', 'Comparativa Tracks'[Baseline (MBPE)] * 'Comparativa Tracks'[MAE LOYO Cal] ), SUMX ( 'Comparativa Tracks', 'Comparativa Tracks'[Baseline (MBPE)] ) )
		formatString: #,##0.00
		displayFolder: 4. Comparativa Ambientes
		lineageTag: c0a10001-2b3c-4d5e-8f90-a1b2c3d40010

	/// Guard de coherencia: verifica que Producción y Calidad provienen de la MISMA corrida (fecha + quarter). Si no, toda la comparación es inválida.
	measure 'Coherencia Tracks' =
			VAR fP = CALCULATE ( MAX ( 'Corrida'[Fecha Predicción] ), REMOVEFILTERS ( 'Ambiente' ), 'Ambiente'[Ambiente] = "Producción" )
			VAR fC = CALCULATE ( MAX ( 'Corrida'[Fecha Predicción] ), REMOVEFILTERS ( 'Ambiente' ), 'Ambiente'[Ambiente] = "Calidad" )
			VAR qP = CALCULATE ( MAX ( 'Corrida'[Q Objetivo] ), REMOVEFILTERS ( 'Ambiente' ), 'Ambiente'[Ambiente] = "Producción" )
			VAR qC = CALCULATE ( MAX ( 'Corrida'[Q Objetivo] ), REMOVEFILTERS ( 'Ambiente' ), 'Ambiente'[Ambiente] = "Calidad" )
			RETURN
			IF (
				fP = fC && qP = qC,
				"✔ Corridas coherentes · " & qP & " · generadas " & FORMAT ( fP, "yyyy-mm-dd" ),
				"⚠ ADVERTENCIA: tracks de corridas DISTINTAS — Prod " & FORMAT ( fP, "yyyy-mm-dd" ) & " (" & qP & ") vs Cal " & FORMAT ( fC, "yyyy-mm-dd" ) & " (" & qC & ") — comparación NO válida"
			)
		displayFolder: 4. Comparativa Ambientes
		lineageTag: c0a10001-2b3c-4d5e-8f90-a1b2c3d40011

	/// Guard de staleness: cruza el Vol70 Producción de comparativa_tracks.csv contra la unión viva a Brent 70 (tolerancia 0.5 MBPE). Vacío si está alineado.
	measure 'Comparativa Alineada' =
			VAR vLive = CALCULATE ( [Vol 1P Prod], REMOVEFILTERS ( 'Precio Brent' ), REMOVEFILTERS ( 'Campo' ), 'Precio Brent'[Brent (USD/bbl)] = 70 )
			VAR vComp = CALCULATE ( SUMX ( 'Comparativa Tracks', 'Comparativa Tracks'[Vol70 Prod] ), REMOVEFILTERS ( 'Campo' ) )
			RETURN
			IF ( ABS ( vLive - vComp ) <= 0.5, BLANK (), "⚠ comparativa_tracks.csv desfasado del track vivo (Dif@70 = " & FORMAT ( vLive - vComp, "#,##0.0" ) & " MBPE) — regenerar con PRED_TRACK=calidad" )
		displayFolder: 4. Comparativa Ambientes
		lineageTag: c0a10001-2b3c-4d5e-8f90-a1b2c3d40012

	/// Banda baja del portafolio (percentil 10 de residuales LOYO, isotónica). Campos sin
	/// banda propia (menos de 2 vigencias reales) aportan su predicción central via
	/// COALESCE — así la banda sumada del portafolio SIEMPRE encierra la curva central
	/// (antes 'Vol P10 Cal' sumaba solo los campos con banda y quedaba por debajo de la
	/// curva completa; ver docs/MAESTRO.md §10, fix 2026-07-15). Respeta el slicer de
	/// Ambiente igual que 'Vol 1P Predicho'.
	measure 'Vol 1P P10' =
			VAR _motor = IF ( HASONEVALUE ( 'Motor'[Motor] ), VALUES ( 'Motor'[Motor] ), "Isotonica" )
			VAR _amb = IF ( HASONEVALUE ( 'Ambiente'[Ambiente] ), VALUES ( 'Ambiente'[Ambiente] ), "Producción" )
			RETURN
			CALCULATE (
				SUMX (
					VALUES ( 'Predicción'[Campo Clave] ),
					COALESCE (
						CALCULATE ( SUM ( 'Predicción'[Vol P10 (MBPE)] ) ),
						CALCULATE ( SUM ( 'Predicción'[Volumen 1P Predicho (MBPE)] ) )
					)
				),
				KEEPFILTERS ( 'Motor'[Motor] = _motor ),
				KEEPFILTERS ( 'Ambiente'[Ambiente] = _amb )
			)
		formatString: #,##0.0
		displayFolder: 4. Comparativa Ambientes
		lineageTag: 452c33e9-8ff5-4dfd-a13b-bc93ab25e136

	/// Banda alta del portafolio (percentil 90 de residuales LOYO, isotónica). Misma
	/// mecánica de COALESCE que 'Vol 1P P10' — ver esa medida.
	measure 'Vol 1P P90' =
			VAR _motor = IF ( HASONEVALUE ( 'Motor'[Motor] ), VALUES ( 'Motor'[Motor] ), "Isotonica" )
			VAR _amb = IF ( HASONEVALUE ( 'Ambiente'[Ambiente] ), VALUES ( 'Ambiente'[Ambiente] ), "Producción" )
			RETURN
			CALCULATE (
				SUMX (
					VALUES ( 'Predicción'[Campo Clave] ),
					COALESCE (
						CALCULATE ( SUM ( 'Predicción'[Vol P90 (MBPE)] ) ),
						CALCULATE ( SUM ( 'Predicción'[Volumen 1P Predicho (MBPE)] ) )
					)
				),
				KEEPFILTERS ( 'Motor'[Motor] = _motor ),
				KEEPFILTERS ( 'Ambiente'[Ambiente] = _amb )
			)
		formatString: #,##0.0
		displayFolder: 4. Comparativa Ambientes
		lineageTag: e15a7ad5-24f4-4667-98d6-4f2aaafe6898

	/// Banda P10 sobre el eje desconectado 'Eje Brent' (respeta el slicer de Ambiente activo).
	measure 'Vol P10 Curva' = CALCULATE ( [Vol 1P P10], REMOVEFILTERS ( 'Precio Brent' ), TREATAS ( VALUES ( 'Eje Brent'[Brent (USD/bbl)] ), 'Precio Brent'[Brent (USD/bbl)] ) )
		formatString: #,##0.0
		displayFolder: 2. Price Intelligence
		lineageTag: 453ee320-a0d1-4728-bd23-9e236d3f0f48

	/// Banda P90 sobre el eje desconectado 'Eje Brent' (respeta el slicer de Ambiente activo).
	measure 'Vol P90 Curva' = CALCULATE ( [Vol 1P P90], REMOVEFILTERS ( 'Precio Brent' ), TREATAS ( VALUES ( 'Eje Brent'[Brent (USD/bbl)] ), 'Precio Brent'[Brent (USD/bbl)] ) )
		formatString: #,##0.0
		displayFolder: 2. Price Intelligence
		lineageTag: 30d960f5-6718-482c-b3fc-ee73b1478437

	/// Ancho de la banda P10-P90 sobre 'Eje Brent' (para la capa de área sombreada apilada).
	measure 'Vol Banda P10-P90 Curva' = [Vol P90 Curva] - [Vol P10 Curva]
		formatString: #,##0.0
		displayFolder: 2. Price Intelligence
		lineageTag: 86be0b1a-0e20-46c3-bb20-bda03bd3cf2a

	/// Rango P10-P90 formateado para tarjetas/tooltips.
	measure 'Rango P10-P90 (MBPE)' = FORMAT ( [Vol 1P P10], "#,##0" ) & " - " & FORMAT ( [Vol 1P P90], "#,##0" )
		displayFolder: 1. Volumen
		lineageTag: e65ad191-f3ed-41ee-9647-a67fcfa7daa0

	/// Ancho de la banda P10-P90 del track Calidad sobre 'Eje Brent' (capa de área apilada en la página Producción vs Calidad).
	measure 'Vol Banda P10-P90 Curva Cal' = [Vol P90 Curva Cal] - [Vol P10 Curva Cal]
		formatString: #,##0.0
		displayFolder: 4. Comparativa Ambientes
		lineageTag: 3b1d8b09-f3f8-46e1-9a84-76d7082d9a93

	/// 1P certificado cierre 2025 ECP S.A. (sin filiales) — número de comparación 2026 (~1685 MBPE). Distinto de 'Vol 1P Baseline' (carry-forward A-1 per-campo): un campo sin cierre 2025 real no aporta aquí.
	measure 'Cierre 2025 (MBPE)' = SUMX ( VALUES ( 'Campo'[Campo] ), CALCULATE ( MAX ( 'Modelo Campo'[Cierre 2025 (MBPE)] ) ) )
		formatString: 0.0000
		displayFolder: 1. Volumen
		lineageTag: f6b2fef6-e028-4bd7-b862-cbcc7b78ba01

	measure 'Δ vs Cierre 2025 (MBPE)' = [Vol 1P Predicho] - [Cierre 2025 (MBPE)]
		formatString: #,##0.0
		displayFolder: 1. Volumen
		lineageTag: 1ba35316-6e51-4f28-922f-b480eda21ac3

	measure 'Δ vs Cierre 2025 %' = DIVIDE ( [Δ vs Cierre 2025 (MBPE)], [Cierre 2025 (MBPE)] )
		formatString: 0.0%
		displayFolder: 1. Volumen
		lineageTag: cf5a6895-2235-4e21-aab9-dd4f12d33d59

	/// Banda LOYO baja del campo seleccionado en Explorador de Campo (eje Precio Neto, motor Isotónica).
	measure 'Vol P10 Campo' =
			VAR _amb = IF ( HASONEVALUE ( 'Ambiente'[Ambiente] ), VALUES ( 'Ambiente'[Ambiente] ), "Producción" )
			RETURN
			CALCULATE ( SUM ( 'Diagnóstico M1'[Vol P10 (MBPE)] ), KEEPFILTERS ( 'Motor'[Motor] = "Isotonica" ), KEEPFILTERS ( 'Ambiente'[Ambiente] = _amb ) )
		formatString: #,##0.0
		displayFolder: 2. Price Intelligence
		lineageTag: 138407cb-1693-41bd-8f5d-8539c8344b10

	/// Banda LOYO alta del campo seleccionado en Explorador de Campo (eje Precio Neto, motor Isotónica).
	measure 'Vol P90 Campo' =
			VAR _amb = IF ( HASONEVALUE ( 'Ambiente'[Ambiente] ), VALUES ( 'Ambiente'[Ambiente] ), "Producción" )
			RETURN
			CALCULATE ( SUM ( 'Diagnóstico M1'[Vol P90 (MBPE)] ), KEEPFILTERS ( 'Motor'[Motor] = "Isotonica" ), KEEPFILTERS ( 'Ambiente'[Ambiente] = _amb ) )
		formatString: #,##0.0
		displayFolder: 2. Price Intelligence
		lineageTag: 6bc36ae0-c8f3-4c75-8ecd-516436f7d971

	measure 'Ancho Banda Campo' = [Vol P90 Campo] - [Vol P10 Campo]
		formatString: #,##0.0
		displayFolder: 2. Price Intelligence
		lineageTag: 6fda55b0-4a8b-4ada-bd47-74dee6684763

	measure 'MAE LOYO Prom' = AVERAGEX ( VALUES ( 'Campo'[Campo] ), CALCULATE ( MAX ( 'Modelo Campo'[MAE LOYO (MBPE)] ) ) )
		formatString: #,##0.00
		displayFolder: 3. Confiabilidad
		lineageTag: 223b53b7-6ff7-4b68-981e-94d08fd502c4

	measure 'Skill LOYO Prom' = AVERAGEX ( VALUES ( 'Campo'[Campo] ), CALCULATE ( MAX ( 'Modelo Campo'[Skill LOYO] ) ) )
		formatString: 0.000
		displayFolder: 3. Confiabilidad
		lineageTag: f67e75c8-c141-4b8d-aebc-b1d38233cd7c

	measure 'Ancho Banda LOYO Prom' = AVERAGEX ( VALUES ( 'Campo'[Campo] ), CALCULATE ( MAX ( 'Predicción'[Ancho Banda LOYO (MBPE)] ) ) )
		formatString: #,##0.0
		displayFolder: 3. Confiabilidad
		lineageTag: 76368e41-1bd2-4930-9397-f69fe8b9f1ee

	/// Campos con sesgo de recuperación > 15% (umbral CONFIANZA_SESGO_RECUP_MAX del pipeline) — el ancla p_ref cae en el valle de la última vigencia y la curva 'recupera' nivel histórico al subir el Brent.
	measure '# Campos Sesgo Recuperación' = CALCULATE ( DISTINCTCOUNT ( 'Modelo Campo'[Campo Clave] ), KEEPFILTERS ( 'Modelo Campo'[Sesgo Recuperación] > 0.15 ) )
		formatString: #,##0
		displayFolder: 3. Confiabilidad
		lineageTag: ba299636-d57c-4902-a790-77fa67242e63

	/// Campos con Brent por encima del techo de la banda del deck, evaluado AL BRENT DE REFERENCIA (no en toda la grilla — Es Clipped varía por fila de Brent, y esta página no tiene slicer de Brent propio).
	measure '# Campos Clipped' =
			VAR bref = MAX ( 'Corrida'[Brent Ref (USD/bbl)] )
			RETURN
			CALCULATE (
			    DISTINCTCOUNT ( 'Predicción'[Campo Clave] ),
			    REMOVEFILTERS ( 'Precio Brent' ),
			    'Precio Brent'[Brent (USD/bbl)] = ROUND ( bref, 2 ),
			    KEEPFILTERS ( 'Predicción'[Es Clipped] = TRUE () )
			)
		formatString: #,##0
		displayFolder: 3. Confiabilidad
		lineageTag: cb49692f-1acf-46d0-b22a-427e922e6e52

	/// Campos con Brent fuera de banda histórica ±$5, evaluado AL BRENT DE REFERENCIA (no en toda la grilla).
	measure '# Campos Extrapolados' =
			VAR bref = MAX ( 'Corrida'[Brent Ref (USD/bbl)] )
			RETURN
			CALCULATE (
			    DISTINCTCOUNT ( 'Predicción'[Campo Clave] ),
			    REMOVEFILTERS ( 'Precio Brent' ),
			    'Precio Brent'[Brent (USD/bbl)] = ROUND ( bref, 2 ),
			    KEEPFILTERS ( 'Predicción'[Es Extrapolado] = TRUE () )
			)
		formatString: #,##0
		displayFolder: 3. Confiabilidad
		lineageTag: ac5a3224-a25a-4b47-adb7-565373e82b64

	/// Campos con ALERTA_BK poblada: BK_SUPERA_PRECIO_REF (piso capado por certificación) o SIN_REANCLAJE (curva sin shift).
	measure '# Campos BK Inconsistente' = CALCULATE ( DISTINCTCOUNT ( 'Modelo Campo'[Campo Clave] ), KEEPFILTERS ( NOT ISBLANK ( 'Modelo Campo'[Alerta BK] ) && 'Modelo Campo'[Alerta BK] <> "" ) )
		formatString: #,##0
		displayFolder: 3. Confiabilidad
		lineageTag: 3768ba12-7fa2-484f-acb6-e5f564897e21

	/// Volumen del campo SOLO si dispara Sesgo de Recuperación (>15%) — para barra apilada por tipo de alerta.
	measure 'Vol si Sesgo Recuperación (MBPE)' = IF ( CALCULATE ( COUNTROWS ( FILTER ( 'Modelo Campo', 'Modelo Campo'[Sesgo Recuperación] > 0.15 ) ) ) > 0, [Vol 1P Predicho] )
		formatString: #,##0.0
		displayFolder: 3. Confiabilidad
		lineageTag: 3048eaf7-b363-4906-824a-5513492c96ae

	/// Volumen del campo SOLO si dispara Clipped (Brent sobre el techo de banda del deck).
	measure 'Vol si Clipped (MBPE)' = IF ( CALCULATE ( COUNTROWS ( FILTER ( 'Predicción', 'Predicción'[Es Clipped] = TRUE () ) ) ) > 0, [Vol 1P Predicho] )
		formatString: #,##0.0
		displayFolder: 3. Confiabilidad
		lineageTag: 7978e974-7e4e-4bc9-9037-e98f8c2c6eaa

	/// Volumen del campo SOLO si dispara Extrapolado (Brent fuera de banda histórica ±$5).
	measure 'Vol si Extrapolado (MBPE)' = IF ( CALCULATE ( COUNTROWS ( FILTER ( 'Predicción', 'Predicción'[Es Extrapolado] = TRUE () ) ) ) > 0, [Vol 1P Predicho] )
		formatString: #,##0.0
		displayFolder: 3. Confiabilidad
		lineageTag: b44fae24-f867-485a-bf45-0c2c6bdc80e1

	/// Método real del motor seleccionado: Isotonica → Isotónica; Suave → el híbrido adoptado por campo (s11/s12, columna 'Método Real Suave' de Modelo Campo).
	measure 'Método del Motor' =
			IF (
				SELECTEDVALUE ( 'Motor'[Motor], "Isotonica" ) = "Suave",
				COALESCE ( SELECTEDVALUE ( 'Modelo Campo'[Método Real Suave] ), "Suave" ),
				"Isotónica"
			)
		displayFolder: 2. Price Intelligence
		lineageTag: c3d4e5f6-0001-4003-9003-000000000001

	/// Volumen en el ancla p_ref del campo = Baseline (Vol(p_ref) = baseline por construcción del re-anclaje). Traduce la banda de volumen al espacio delta.
	measure 'Vol Ancla Campo' =
			VAR _amb = IF ( HASONEVALUE ( 'Ambiente'[Ambiente] ), VALUES ( 'Ambiente'[Ambiente] ), "Producción" )
			RETURN
			CALCULATE ( AVERAGE ( 'Modelo Campo'[Volumen 1P Baseline (MBPE)] ), KEEPFILTERS ( 'Ambiente'[Ambiente] = _amb ) )
		formatString: #,##0.0
		displayFolder: 2. Price Intelligence
		lineageTag: c3d4e5f6-0002-4003-9003-000000000002

	/// Banda LOYO baja en espacio DELTA (P10 − volumen del ancla). Para la franja del panel 'Espacio delta' del Explorador.
	measure 'Delta P10 Campo' = [Vol P10 Campo] - [Vol Ancla Campo]
		formatString: #,##0.0
		displayFolder: 2. Price Intelligence
		lineageTag: c3d4e5f6-0003-4003-9003-000000000003

	/// Banda LOYO alta en espacio DELTA (P90 − volumen del ancla).
	measure 'Delta P90 Campo' = [Vol P90 Campo] - [Vol Ancla Campo]
		formatString: #,##0.0
		displayFolder: 2. Price Intelligence
		lineageTag: c3d4e5f6-0004-4003-9003-000000000004

	/// Ancho de la banda en espacio delta (= P90 − P10; idéntico al de volumen).
	measure 'Ancho Banda Delta Campo' = [Delta P90 Campo] - [Delta P10 Campo]
		formatString: #,##0.0
		displayFolder: 2. Price Intelligence
		lineageTag: c3d4e5f6-0005-4003-9003-000000000005

	column _
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: af4d0a27-1c3f-478a-a91c-0fd0a5584395
		summarizeBy: none
		sourceColumn: _

	partition Partition = m
		mode: import
		source =
				let
				    Fuente = #table({"_"}, {{""}})
				in
				    Fuente


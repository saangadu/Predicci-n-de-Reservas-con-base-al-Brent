/// Tabla de hechos: predicción de reservas 1P por Campo × Motor × Brent. Grano = 1 fila por combinación. Cadena M2 (Brent→Precio Neto) → M1 (Precio→Volumen). TIPO_DATO = PREDICCIÓN.
table Predicción
	lineageTag: 8db16789-46ec-4b7d-a9c6-c163847f5e68

	column 'Campo Clave'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 5134e7e4-e139-40dc-87cd-1ef87ff37857
		summarizeBy: none
		sourceColumn: CAMPO

	column 'Motor Clave'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 463b13d8-0154-41e0-b267-0f38d9a28133
		summarizeBy: none
		sourceColumn: MOTOR

	column 'Brent Clave (USD/bbl)'
		dataType: double
		isHidden
		isAvailableInMdx: false
		lineageTag: fe6b78d9-fe77-4470-ab91-66acb072a89e
		summarizeBy: none
		sourceColumn: BRENT_USD_BBL

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Precio neto realizado que sale de M2 (Brent − descuentos, absorbidos en β).
	/// Precio Neto estimado por el Modelo 2 (α + β·Brent) al Brent del escenario. Es el Precio Neto (Brent − descuentos calidad y transporte) que recibe el campo, no el Brent.
	column 'Precio Neto M2 (USD/bbl)'
		dataType: double
		formatString: $#,##0.00
		displayFolder: 2. Precios
		lineageTag: 1e9326a7-ede1-44a3-80f8-201c0dfcd09f
		summarizeBy: sum
		sourceColumn: PRECIO_NETO_EFECTIVO_USD_BBL

		annotation SummarizationSetBy = Automatic


/// Dimensión de precio: rejilla Brent del escenario (eje del slicer). Derivada de la tabla de hechos para mantenerse sincronizada con la rejilla precalculada.
table 'Precio Brent'
	lineageTag: 29ee31bc-5d7e-4f61-b0a7-bc373196b182

	/// Precio Brent escenario. Slicer principal del tablero.
	column 'Brent (USD/bbl)'
		dataType: double
		isKey
		formatString: $#,##0.00
		lineageTag: 7f1b7f08-d7d8-4d7b-8a4a-5e56bf3f911e
		summarizeBy: none
		sourceColumn: Brent (USD/bbl)

	partition Partition = m
		mode: import
		source =
				let
				    Fuente = Table.Distinct(Table.SelectColumns(#"Predicción", {"BRENT_USD_BBL"})),
				    Ren = Table.RenameColumns(Fuente, {{"BRENT_USD_BBL", "Brent (USD/bbl)"}}),
				    Orden = Table.Sort(Ren, {{"Brent (USD/bbl)", Order.Ascending}}),
				    Tipos = Table.TransformColumnTypes(Orden, {{"Brent (USD/bbl)", type number}})
				in
				    Tipos

